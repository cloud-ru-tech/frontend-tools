{
  "name": "@cloud-ru/ft-all-linters-pack",
  "version": "1.2.0",
  "description": "husky + lint-staged + eslint/oxlint + oxfmt/prettier + stylelint",
  "keywords": [
    "husky",
    "lint-staged",
    "eslint",
    "oxlint",
    "oxfmt",
    "prettier",
    "migrate-to-oxfmt",
    "migrate-to-oxlint"
  ],
  "bin": {
    "migrate-to-oxfmt": "./dist/cjs/bin/migrate-to-oxfmt.js",
    "migrate-to-oxlint": "./dist/cjs/bin/migrate-to-oxlint.js"
  },
  "dependencies": {
    "@cloud-ru/eslint-config": "workspace:^",
    "@cloud-ru/ft-config-husky": "workspace:^",
    "@cloud-ru/ft-config-lint-staged": "workspace:^",
    "@cloud-ru/ft-config-oxfmt": "workspace:^",
    "@cloud-ru/ft-config-oxlint": "workspace:^",
    "@cloud-ru/ft-config-prettier": "workspace:^",
    "@cloud-ru/ft-config-stylelint": "workspace:^"
  },
  "author": {
    "name": "Akhremenko Grigorii",
    "url": "https://github.com/AGrigorii"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    "import": "./dist/esm/index.js",
    "require": "./dist/cjs/index.js"
  },
  "files": [
    "dist/esm",
    "dist/cjs",
    "src",
    "./CHANGELOG.md",
    "./LICENSE"
  ],
  "homepage": "https://github.com/cloud-ru-tech/frontend-tools/-/tree/master/packages/all-linters-pack",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-ru-tech/frontend-tools.git",
    "directory": "packages/all-linters-pack"
  }
}
