{
  "name": "@cloud-ru/frontend-tools",
  "version": "1.0.0",
  "description": "Common to frontend projects helpers and utilities",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "add-package": "ts-node scripts/npm-init",
    "build:watch": "tsc -b ./packages/tsconfig.esm.json -w",
    "build:packages:esm": "tsc -b ./packages/tsconfig.esm.json",
    "build:packages:cjs": "tsc -b ./packages/tsconfig.cjs.json",
    "build:packages": "pnpm run clean:dist && pnpm -r run compile && pnpm run build:packages:esm && pnpm run build:packages:cjs",
    "clean:dist": "rimraf --glob ./packages/*/dist",
    "clean:modules": "rimraf --glob ./node_modules ./packages/*/node_modules",
    "deps": "pnpm install",
    "deps:reinstall": "pnpm run clean:dist && pnpm run clean:modules && pnpm install",
    "publish:resolve-specs": "node scripts/prepublish-resolve.mjs",
    "publish:check-specs": "node scripts/check-published-specs.mjs",
    "test:unit": "vitest run"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/cloud-ru-tech/frontend-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/cloud-ru-tech/frontend-tools.git"
  },
  "keywords": [
    "tools",
    "utilities",
    "helpers",
    "hooks",
    "configs"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@cloud-ru/ft-config-commit-message": "workspace:^",
    "@cloud-ru/ft-config-husky": "workspace:^",
    "@cloud-ru/ft-config-stylelint": "workspace:^",
    "@cloud-ru/ft-config-vitest": "workspace:^",
    "@cloud-ru/ft-conventional-changelog-old": "npm:@cloud-ru/ft-conventional-changelog@1.1.0",
    "@cloud-ru/ft-solidarity": "workspace:^",
    "@types/inquirer": "9.0.9",
    "@types/node": "catalog:",
    "@types/shelljs": "0.10.0",
    "eslint": "catalog:",
    "husky": "catalog:",
    "inquirer": "8.2.7",
    "lerna": "9.0.7",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "rimraf": "6.1.3",
    "shelljs": "0.10.0",
    "stylelint": "catalog:",
    "ts-node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.12.2",
      "ejs": "3.1.10",
      "json5": "2.2.3"
    }
  }
}
